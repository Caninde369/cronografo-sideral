rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin = e-mail do Rafael, somente com e-mail verificado.
    // Login com Google sempre chega com email_verified = true.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() == 'rafael.cm333@gmail.com';
    }

    function isValidUserProfile(data) {
      return (data.uid == request.auth.uid || isAdmin())
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'plan', 'createdAt', 'updatedAt', 'lastLoginAt', 'loginCount', 'trialUsedToday', 'totalActiveTimeSeconds', 'lastLoginDate', 'blocked', 'planExpiresAt', 'billing', 'adminNote'])
        && (!('blocked' in data) || data.blocked is bool)
        && (!('planExpiresAt' in data) || (data.planExpiresAt is string && data.planExpiresAt.size() <= 10))
        && (!('billing' in data) || data.billing in ['monthly', 'annual'])
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 1000))
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('role' in data) || data.role == 'user' || (data.role == 'admin' && isAdmin()))
        && (!('plan' in data) || data.plan in ['free', 'monthly', 'lifetime']);
    }

    // Plano pago só pode ser concedido pelo admin (após confirmar o pagamento).
    // O próprio usuário só pode criar o perfil como 'free' e nunca pode mudar o plano.
    function planOnCreateAllowed(data) {
      return data.get('plan', 'free') == 'free' || isAdmin();
    }

    function planUnchangedOrAdmin() {
      return request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free') || isAdmin();
    }

    // Bloqueio, vencimento, cobrança e anotação: só o admin cria ou muda.
    function adminFieldsUnchangedOrAdmin() {
      return isAdmin() || (
        request.resource.data.get('blocked', false) == resource.data.get('blocked', false)
        && request.resource.data.get('planExpiresAt', '') == resource.data.get('planExpiresAt', '')
        && request.resource.data.get('billing', 'monthly') == resource.data.get('billing', 'monthly')
        && request.resource.data.get('adminNote', '') == resource.data.get('adminNote', '')
      );
    }

    function adminFieldsAbsentOnCreate(data) {
      return isAdmin() || !data.keys().hasAny(['blocked', 'planExpiresAt', 'billing', 'adminNote']);
    }

    function isValidSession(data) {
      return data.keys().hasOnly(['start', 'lastSeen', 'seconds'])
        && data.start is string && data.start.size() <= 40
        && data.lastSeen is string && data.lastSeen.size() <= 40
        && data.seconds is int && data.seconds >= 0 && data.seconds <= 172800;
    }

    function roleUnchangedOrAdmin() {
      return request.resource.data.get('role', 'user') == resource.data.get('role', 'user') || isAdmin();
    }

    function isValidSavedMap(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'description', 'targetDate', 'natalDate', 'createdAt', 'updatedAt', 'layout', 'location', 'natalLocation'])
        && data.userId == userId
        && data.name is string
        && data.name.size() <= 200;
    }

    function isValidSavedLayout(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'description', 'layout', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.name is string
        && data.name.size() <= 200;
    }

    // Connection test doc
    match /test/connection {
      allow get: if true;
    }

    // Vagas do plano Vitalício (contador público exibido na janela de planos).
    // Qualquer pessoa lê; só o admin grava, e só números válidos.
    match /config/lifetime {
      allow get: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['sold', 'total', 'updatedAt'])
        && request.resource.data.sold is int && request.resource.data.sold >= 0
        && request.resource.data.total is int && request.resource.data.total > 0;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) || isAdmin()) && isValidId(userId)
        && isValidUserProfile(request.resource.data)
        && planOnCreateAllowed(request.resource.data)
        && adminFieldsAbsentOnCreate(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId)
        && isValidUserProfile(request.resource.data)
        && (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid)
        && roleUnchangedOrAdmin()
        && planUnchangedOrAdmin()
        && adminFieldsUnchangedOrAdmin();

      // Histórico de acessos: o usuário registra, só o admin lê
      match /sessions/{sessionId} {
        allow get, list: if isAdmin();
        allow create: if isOwner(userId) && isValidId(sessionId) && isValidSession(request.resource.data)
          && request.resource.data.seconds == 0;
        allow update: if isOwner(userId) && isValidSession(request.resource.data)
          && request.resource.data.start == resource.data.start
          && request.resource.data.seconds >= resource.data.seconds;
        allow delete: if isAdmin();
      }
      allow delete: if isOwner(userId) || isAdmin();

      // User saved maps subcollection
      match /savedMaps/{mapId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(mapId) && isValidSavedMap(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(mapId) && isValidSavedMap(request.resource.data, userId)
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(mapId);
      }

      // User saved layouts subcollection
      match /savedLayouts/{layoutId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(layoutId) && isValidSavedLayout(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidId(layoutId) && isValidSavedLayout(request.resource.data, userId)
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(layoutId);
      }
    }
  }
}
