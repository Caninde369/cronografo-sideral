{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and astrological preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase user authentication UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL"
        },
        "role": {
          "type": "string",
          "description": "User system role"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "monthly", "lifetime"],
          "description": "User subscription plan"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "ISO timestamp of last login"
        },
        "loginCount": {
          "type": "number",
          "description": "Total number of logins"
        },
        "trialUsedToday": {
          "type": "number",
          "description": "Seconds used today in trial"
        },
        "totalActiveTimeSeconds": {
          "type": "number",
          "description": "Total active usage time accumulated in seconds across all sessions"
        },
        "lastLoginDate": {
          "type": "string",
          "description": "YYYY-MM-DD string of last activity"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of account last update"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "SavedMap": {
      "title": "SavedMap",
      "description": "Astrological map saved by user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the saved map"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "name": {
          "type": "string",
          "description": "User given title for the map"
        },
        "description": {
          "type": "string",
          "description": "Optional notes or details"
        },
        "targetDate": {
          "type": "string",
          "description": "Date of transit or chart"
        },
        "natalDate": {
          "type": "string",
          "description": "Optional natal chart date"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of modification"
        }
      },
      "required": ["id", "userId", "name", "createdAt"]
    },
    "SavedLayout": {
      "title": "SavedLayout",
      "description": "HUD UI and sidebar layout configurations saved by user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the saved layout"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "name": {
          "type": "string",
          "description": "User given title for the layout"
        },
        "description": {
          "type": "string",
          "description": "Optional notes on the layout"
        },
        "layout": {
          "type": "object",
          "description": "Layout configurations and widget state"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of modification"
        }
      },
      "required": ["id", "userId", "name", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "UserProfile"
      },
      "description": "Private user profile and settings"
    },
    "/users/{userId}/savedMaps/{mapId}": {
      "schema": {
        "$ref": "SavedMap"
      },
      "description": "Collection of saved charts and maps owned by user"
    },
    "/users/{userId}/savedLayouts/{layoutId}": {
      "schema": {
        "$ref": "SavedLayout"
      },
      "description": "Collection of saved HUD UI layouts and sidebar customization owned by user"
    }
  }
}
